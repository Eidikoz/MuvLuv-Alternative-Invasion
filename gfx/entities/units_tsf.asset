entity = {
	name = "tsf_entity"
	pdxmesh = "USA_Tsf_F4"

	state = { name = "idle"  animation = "idle"   animation_blend_time = 0.1  animation_speed = 0.5 }
	state = { name = "move"  animation = "move"   animation_blend_time = 0.1  animation_speed = 0.5 looping = no  next_state = "move"
		event = { time = 0  sound = { soundeffect = "airplane_jet_idle" } }
	}
	state = { name = "retreat"  animation = "move"   animation_blend_time = 0.1  animation_speed = 0.5  looping = no  next_state = "move"
		event = { time = 0  sound = { soundeffect = "airplane_jet_idle" } }
	}
	state = { name = "training"				animation = "idle" 			 animation_speed = 0.5	}

	state = { name = "attack"  animation = "GunAttack2"   animation_blend_time = 0.1  animation_speed = 0.7  looping = no  next_state = "attack"  chance = 1
		event = { time = 0  sound = { soundeffect = mechanized_units_mg_fire } } 
	}
	state = { name = "attack"  animation = "GunAttack3"   animation_blend_time = 0.1  animation_speed = 0.7  looping = no  next_state = "attack"  chance = 4
		event = { time = 0  sound = { soundeffect = mechanized_units_mg_fire } } 
	}

	state = { name = "defend"  animation = "GunAttack2"   animation_blend_time = 0.1  animation_speed = 0.7  looping = no  next_state = "defend"  chance = 1
		event = { time = 0  sound = { soundeffect = mechanized_units_mg_fire } } 
	}
	state = { name = "defend"  animation = "GunAttack3"   animation_blend_time = 0.1  animation_speed = 0.7  looping = no  next_state = "defend"  chance = 4
		event = { time = 0  sound = { soundeffect = mechanized_units_mg_fire } } 
	}

	state = { name = "support_attack"   animation = "GunAttack2"  animation_blend_time = 0.1  animation_speed = 0.7  looping = no  next_state = "support_attack"  chance = 1
		event = { time = 0  sound = { soundeffect = mechanized_units_mg_fire } } 
	}
	state = { name = "support_attack"   animation = "GunAttack3"  animation_blend_time = 0.1  animation_speed = 0.7  looping = no  next_state = "support_attack"  chance = 4
		event = { time = 0  sound = { soundeffect = mechanized_units_mg_fire } } 
	}

	scale = 0.5
}

